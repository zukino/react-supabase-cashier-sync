{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "React Supabase Cashier Sync",
  "version": "0.0.0",
  "identifier": "com.cashier.sync",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Cashier System",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  },
  "plugins": {}
}